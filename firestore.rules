rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nearby Shelters Collection
    match /Nearby_Shelters/{shelterId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Shelter Ratings Collection
    match /shelters_ratings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Emergency Resources Collection
    match /emergencyResources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Safety Tips Collection
    match /safetyTips/{tipId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Quiz Questions Collection
    match /disaster_awareness_questions/{questionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Notification History Collection
    match /notification_history/{historyId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      allow create, update: if request.auth != null;
      allow delete: if false; // Prevent deletion of notification history
    }

    // SOS Events
    match /sosEvents/{sosId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Manual Earthquake Entries
    match /Earthquake/{document=**} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Nepal Earthquakes
    match /nepal_earthquakes/{earthquakeId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Alerts collection
    match /alerts/{alertId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Posts with subcollections
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null;
      }
      match /likes/{likeId} {
        allow read: if true;
        allow create, delete: if request.auth != null;
      }
    }

    // Flood Warning Stations Collection
    match /warningStations/{stationId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Earthquakes Collection (added for map.tsx)
    match /earthquakes/{earthquakeId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Quiz Attempts
    match /quiz_attempts/{attemptId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Quiz Metadata
    match /quiz_metadata/{metadataId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Quiz Results
    match /quiz_results/{resultId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 